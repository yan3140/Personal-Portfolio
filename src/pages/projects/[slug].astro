---
import {
  ArrowLeft,
  ArrowRight,
  ArrowUpRight,
  BriefcaseBusiness,
  Building2,
  CalendarDays,
  Code2,
} from "lucide-astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { portfolio, type Project } from "../../data/portfolio";
import { projectDetails, type ProjectDetail } from "../../data/projectDetails";
import "../../styles/project-detail.css";

interface Props {
  project: Project;
  detail: ProjectDetail;
  previous: Project;
  next: Project;
}

export function getStaticPaths() {
  return portfolio.projects.map((project, index, projects) => {
    const detail = projectDetails.find((item) => item.slug === project.slug);
    if (!detail) throw new Error(`Missing detail data for project: ${project.slug}`);

    return {
      params: { slug: project.slug },
      props: {
        project,
        detail,
        previous: projects[(index - 1 + projects.length) % projects.length],
        next: projects[(index + 1) % projects.length],
      },
    };
  });
}

const { project, detail, previous, next } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const projectHref = (slug: string) => `${baseUrl}projects/${slug}/`;
---

<BaseLayout title={`${project.name} | Lingxiao Pang`} description={project.summary}>
  <Header />
  <main class="project-detail-page" data-tone={project.tone}>
    <section class="project-detail-intro" aria-labelledby="project-title">
      <div class="shell project-detail-intro__inner">
        <a class="project-back" href={`${baseUrl}#projects`}>
          <ArrowLeft size={16} stroke-width={1.8} />
          返回作品集
        </a>

        <p class="project-detail-badge">{detail.type}</p>
        <h1 id="project-title">{project.name}</h1>
        <p class="project-detail-label">{detail.shortLabel}</p>

        <div class="project-detail-meta" aria-label="项目基本信息">
          <span><BriefcaseBusiness size={17} stroke-width={1.7} />{detail.role}</span>
          <span><CalendarDays size={17} stroke-width={1.7} />{detail.period}</span>
          <span><Building2 size={17} stroke-width={1.7} />{detail.organization}</span>
        </div>
      </div>
    </section>

    <section class="project-detail-content" aria-label="项目详情">
      <div class="shell project-detail-layout">
        <div class="project-detail-main">
          <section class="project-copy-section" aria-labelledby="overview-title" data-reveal>
            <h2 id="overview-title"><i aria-hidden="true"></i>项目概述</h2>
            <p class="project-overview">{detail.overview}</p>
          </section>

          <section class="project-copy-section" aria-labelledby="metrics-title" data-reveal>
            <h2 id="metrics-title"><i aria-hidden="true"></i>验证数据</h2>
            <div class="project-metrics">
              {detail.metrics.map((metric) => (
                <article>
                  <strong>{metric.value}</strong>
                  <span>{metric.label}</span>
                  <p>{metric.note}</p>
                </article>
              ))}
            </div>
          </section>

          <section class="project-copy-section" aria-labelledby="results-title" data-reveal>
            <h2 id="results-title"><i aria-hidden="true"></i>核心成果</h2>
            <ol class="project-results">
              {detail.results.map((result, index) => (
                <li>
                  <span>{index + 1}</span>
                  <div>
                    <h3>{result.title}</h3>
                    <p>{result.description}</p>
                    <small>{result.evidence}</small>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        </div>

        <aside class="project-sidebar" aria-label="项目补充信息">
          <section class="project-side-panel">
            <h2>技术栈</h2>
            <div class="project-stack">
              {detail.stack.map((technology) => <span>{technology}</span>)}
            </div>
          </section>

          <section class="project-side-panel">
            <h2>涉及技能方向</h2>
            <div class="project-skill-groups">
              {detail.skillGroups.map((group) => (
                <div>
                  <h3>{group.title}</h3>
                  <p>{group.items.join(" / ")}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="project-side-panel project-side-panel--info">
            <h2>项目信息</h2>
            <dl>
              <div><dt>类型</dt><dd>{detail.type}</dd></div>
              <div><dt>角色</dt><dd>{detail.role}</dd></div>
              <div><dt>周期</dt><dd>{detail.period}</dd></div>
              <div><dt>状态</dt><dd>{detail.status}</dd></div>
            </dl>

            {project.repository && (
              <a class="project-source" href={project.repository} target="_blank" rel="noreferrer">
                <Code2 size={17} stroke-width={1.8} />
                查看源码
                <ArrowUpRight size={15} stroke-width={1.8} />
              </a>
            )}
          </section>
        </aside>
      </div>
    </section>

    <nav class="project-detail-nav" aria-label="其他项目">
      <div class="shell project-detail-nav__inner">
        <a href={projectHref(previous.slug)}>
          <ArrowLeft size={17} stroke-width={1.8} />
          <span><small>PREVIOUS</small>{previous.name}</span>
        </a>
        <a href={projectHref(next.slug)}>
          <span><small>NEXT</small>{next.name}</span>
          <ArrowRight size={17} stroke-width={1.8} />
        </a>
      </div>
    </nav>
  </main>
  <Footer />
</BaseLayout>
